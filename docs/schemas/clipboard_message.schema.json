{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syncmate.local/schemas/clipboard_message.schema.json",
  "title": "SyncMate 剪切板同步消息（WebSocket 帧）",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "contentType", "content", "timestamp"],
  "properties": {
    "type": { "type": "string", "enum": ["clipboard_update", "ping", "pong"] },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$",
      "description": "内容来源设备指纹，防回声关键字段；ping/pong 可省略"
    },
    "contentType": { "type": "string", "enum": ["text", "image"], "description": "仅 clipboard_update" },
    "content": { "type": "string", "description": "文本原文，或图片 PNG 字节的 Base64" },
    "timestamp": { "type": "integer", "description": "Unix 毫秒，接收端去重依据" }
  }
}
