{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syncmate.local/schemas/file_move_request.schema.json",
  "title": "SyncMate 移动/重命名请求",
  "type": "object",
  "additionalProperties": false,
  "required": ["from", "to"],
  "properties": {
    "from": { "type": "string", "description": "源绝对路径" },
    "to": { "type": "string", "description": "目标绝对路径（目录时为目标目录，或完整新路径）" }
  }
}
