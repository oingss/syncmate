{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syncmate.local/schemas/file_list_response.schema.json",
  "title": "SyncMate 目录列表响应",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "entries"],
  "properties": {
    "path": { "type": "string", "description": "规范化后的当前路径" },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/file_entry"
      }
    }
  },
  "definitions": {
    "file_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "isDir", "size", "modified"],
      "properties": {
        "name": { "type": "string" },
        "isDir": { "type": "boolean" },
        "size": { "type": "integer", "description": "字节数，目录恒为 0" },
        "modified": { "type": "integer", "description": "修改时间，Unix 毫秒" }
      }
    }
  }
}
