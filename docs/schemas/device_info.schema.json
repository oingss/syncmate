{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syncmate.local/schemas/device_info.schema.json",
  "title": "SyncMate 设备信息（连接响应 / GET /api/device/info）",
  "type": "object",
  "additionalProperties": false,
  "required": ["alias", "deviceType", "fingerprint", "port", "protocol"],
  "properties": {
    "alias": { "type": "string", "minLength": 1, "maxLength": 64 },
    "deviceType": { "type": "string", "enum": ["windows", "android"] },
    "fingerprint": { "type": "string", "pattern": "^[0-9A-F]{64}$", "description": "设备身份 ID" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "protocol": { "type": "string", "enum": ["http"] },
    "appVersion": { "type": "string" },
    "osVersion": { "type": "string" },
    "storageFree": { "type": "integer", "description": "剩余空间，字节" },
    "storageTotal": { "type": "integer", "description": "总空间，字节" }
  }
}
