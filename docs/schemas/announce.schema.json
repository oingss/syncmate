{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://syncmate.local/schemas/announce.schema.json",
  "title": "SyncMate 组播发现广播报文",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "alias", "deviceType", "fingerprint", "port", "protocol"],
  "properties": {
    "v": { "type": "integer", "const": 1, "description": "协议版本" },
    "alias": { "type": "string", "minLength": 1, "maxLength": 64 },
    "deviceType": { "type": "string", "enum": ["windows", "android"] },
    "fingerprint": { "type": "string", "pattern": "^[0-9A-F]{64}$", "description": "设备身份 ID（首启随机生成并持久化），大写 HEX" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "本机 HTTP 服务端口" },
    "protocol": { "type": "string", "enum": ["http"] },
    "appVersion": { "type": "string" }
  }
}
